# NOTEAI 환경 설정 (.env)
# 이 파일을 .env로 복사하고 필요에 따라 수정하세요

# 앱 설정
APP_NAME=NOTEAI
APP_VERSION=1.0.0
DEBUG=True

# 서버 설정
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 데이터베이스 (개발) - 파일은 backend/data/noteai.db 에 고정 저장됩니다.
DATABASE_URL=sqlite:///./noteai.db
DATA_DIR=./data

# 데이터베이스 (프로덕션 - PostgreSQL). 계정을 재시작 후에도 유지하려면 이것을 쓰세요.
# DATABASE_URL=postgresql://user:password@localhost/noteai

# JWT 설정 (값은 배포 환경에서 바꾸지 마세요. 바뀌면 기존 로그인이 전부 풀립니다.)
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 보안
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# 파일 업로드
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads

# AI/NLP
AI_MODEL_NAME=facebook/bart-large-cnn
AI_MAX_TOKENS=150

# ============ Vault (로컬 노트 스캔) ============
# 스캔 허용 루트 (비우면 제한 없음 - 프로덕션에서는 반드시 지정)
# VAULT_ALLOWED_ROOTS=["C:/Users/me/Documents/research-notes"]
VAULT_MAX_FILE_SIZE=2097152

# ============ Trends (기술 트렌드 수집) ============
TRENDS_TIMEOUT_SECONDS=20.0
TRENDS_DISABLED_SOURCES=[]
# TRENDS_CUSTOM_FEEDS=["https://example.com/feed.xml"]

# NewsAPI (선택) - 키가 없으면 RSS 소스만 사용
NEWSAPI_KEY=
NEWSAPI_LANGUAGE=en
